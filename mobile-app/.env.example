# Google OAuth client IDs for native sign-in.
# These are PUBLIC (they ship inside any app binary) — safe to commit.
# The web client SECRET is NOT here: it lives only in Supabase → Auth → Google.
#
# Copy this file to `.env` and paste your real IDs, then rebuild:
#   cp .env.example .env
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so `expo
# start` (dev client) and `eas build` both pick them up from this file.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="555526225800-2d02vig8hi1fdakmbh07q4bkb6v3p8um.apps.googleusercontent.com"

# iOS only — leave blank until you build for iOS:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
